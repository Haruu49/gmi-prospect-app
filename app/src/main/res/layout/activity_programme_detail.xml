<?xml version="1.0" encoding="utf-8"?>
<!-- Programme details: overview, key facts, study content, entry requirements
     and official sources. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ProgrammeDetailActivity">

    <include layout="@layout/view_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/detail_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/detail_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/white_translucent"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    app:tint="@color/white"
                    tools:src="@drawable/ic_flight" />

                <TextView
                    android:id="@+id/detail_short"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/white_muted"
                    tools:text="GAPP" />

                <TextView
                    android:id="@+id/detail_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="@string/prog_gapp_name" />

                <View
                    android:layout_width="56dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_accent_bar" />

                <TextView
                    android:id="@+id/detail_tagline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/white_muted"
                    tools:text="@string/prog_gapp_tagline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:id="@+id/detail_sections">

                <!-- Overview -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_overview"
                            android:textAppearance="@style/TextAppearance.GMI.SectionTitle" />

                        <TextView
                            android:id="@+id/detail_overview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="@style/TextAppearance.GMI.Body"
                            tools:text="@string/prog_gapp_overview" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Key facts -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/detail_key_facts"
                            android:textAppearance="@style/TextAppearance.GMI.SectionTitle" />

                        <include
                            android:id="@+id/fact_intake"
                            layout="@layout/item_contact_row" />

                        <include
                            android:id="@+id/fact_duration"
                            layout="@layout/item_contact_row" />

                        <include
                            android:id="@+id/fact_pathway"
                            layout="@layout/item_contact_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- What you will study -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_offered"
                            android:textAppearance="@style/TextAppearance.GMI.SectionTitle" />

                        <TextView
                            android:id="@+id/detail_offered"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="@style/TextAppearance.GMI.Body"
                            tools:text="@string/prog_gapp_offered" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Entry requirements -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_requirements"
                            android:textAppearance="@style/TextAppearance.GMI.SectionTitle" />

                        <TextView
                            android:id="@+id/detail_requirements"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="@style/TextAppearance.GMI.Body"
                            android:textColor="@color/text_primary"
                            tools:text="@string/prog_gapp_requirements" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Official sources -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_sources"
                            android:textAppearance="@style/TextAppearance.GMI.SectionTitle" />

                        <TextView
                            android:id="@+id/detail_sources"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:autoLink="web"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/text_secondary"
                            android:textColorLink="@color/brand_primary"
                            tools:text="@string/prog_gapp_sources" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Actions -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/action_check_eligibility"
                    app:icon="@drawable/ic_assignment_turned_in" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_official"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_official_page"
                    app:icon="@drawable/ic_open_in_new" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
