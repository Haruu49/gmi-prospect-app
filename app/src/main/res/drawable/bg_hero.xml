<?xml version="1.0" encoding="utf-8"?>
<!-- Home welcome banner: blue-to-navy gradient with decorative circles (like gmi.edu.my banners). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/gmi_navy"
                android:startColor="@color/gmi_blue" />
        </shape>
    </item>
    <item
        android:width="260dp"
        android:height="260dp"
        android:gravity="top|end"
        android:right="-90dp"
        android:top="-110dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:bottom="-90dp"
        android:gravity="bottom|start"
        android:left="-60dp">
        <shape android:shape="oval">
            <solid android:color="#0FFFFFFF" />
        </shape>
    </item>
</layer-list>
